gunBtn.MouseButton1Click:Connect(function()

	buttonBounce(gunBtn)

	local gun =
		workspace:FindFirstChild("GunDrop",true)

	if not gun then

		gunBtn.Text = "Gun Not Dropped"

		showNotification(
			"No GunDrop was found in the game."
		)

		task.delay(1.5,function()
			gunBtn.Text = "Get Dropped Gun"
		end)

		return
	end

	local character = plr.Character

	if not character then
		return
	end

	local root =
		character:FindFirstChild("HumanoidRootPart")

	if not root then
		return
	end

	local gunPart

	if gun:IsA("BasePart") then

		gunPart = gun

	else

		gunPart =
			gun:FindFirstChildWhichIsA(
				"BasePart",
				true
			)

	end

	if gunPart then

		root.CFrame =
			gunPart.CFrame +
			Vector3.new(0,3,0)

		gunBtn.Text = "Gun Found"

		showNotification(
			"Teleported you to the dropped gun."
		)

		task.delay(1.5,function()
			gunBtn.Text = "Get Dropped Gun"
		end)

	else

		showNotification(
			"The GunDrop has no BasePart."
		)

	end

end)

