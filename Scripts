-- RIGHT SHIFT
--------------------------------------------------

UIS.InputBegan:Connect(function(input,processed)

	if processed then
		return
	end

	if input.KeyCode == Enum.KeyCode.RightShift then

		menu.Visible = not menu.Visible

		toggle.Text =
			menu.Visible and "CLOSE" or "OPEN"

		showNotification(
			menu.Visible
			and "Menu opened."
			or "Menu closed."
		)

	end

end)
